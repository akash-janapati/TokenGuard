# Copy to .env and fill in. Cloud provider: mock | anthropic | openai (any OpenAI-compatible API)
CLOUD_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
CLOUD_MAX_TOKENS=16000
# For OpenAI / Groq / OpenRouter etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

LOCAL_MODEL=qwen2.5-coder:7b
LOCAL_THRESHOLD=0.35
CLOUD_THRESHOLD=0.65
MIN_LOCAL_CONFIDENCE=0.7
CLOUD_CONTEXT_TOKEN_BUDGET=3000
