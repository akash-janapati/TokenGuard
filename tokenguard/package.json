{
  "name": "tokenguard",
  "displayName": "TokenGuard",
  "description": "AI Router and token optimizer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:localpilot.chatView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tokenguard.openChat",
        "title": "Open LocalPilot",
        "category": "TokenGuard",
        "icon": "$(circuit-board)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localpilot-sidebar",
          "title": "LocalPilot",
          "icon": "./media/circuit-board.svg"
        }
      ]
    },
    "views": {
      "localpilot-sidebar": [
        {
          "type": "webview",
          "id": "localpilot.chatView",
          "name": "LocalPilot Assistant",
          "icon": "./media/circuit-board.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
